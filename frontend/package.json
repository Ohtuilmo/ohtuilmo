{
  "name": "ohtuilmo-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/styles": "^6.4.8",
    "axios": "^1.19.0",
    "history": "^5.3.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-drag-list": "^1.1.0",
    "react-markdown": "^8.0.7",
    "react-redux": "^5.1.1",
    "react-router-dom": "^7.18.2",
    "react-select": "^2.4.1",
    "recharts": "^2.12.3",
    "redux": "^4.0.1",
    "redux-thunk": "^2.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test-setup": "npm run test-setup:down && docker compose -f ../compose.local-test.yaml --profile local-e2e up -d",
    "test-setup:down": "docker compose -f ../compose.local-test.yaml --profile local-e2e down",
    "test:docker": "docker compose -f ../compose.local-test.yaml --profile e2e up --force-recreate --exit-code-from cypress",
    "test:docker:down": "docker compose -f ../compose.local-test.yaml --profile e2e down",
    "test": "CYPRESS_baseUrl=http://localhost:5000 npx cypress open",
    "test:headless": "CYPRESS_VIDEO=false CYPRESS_baseUrl=http://localhost:5000 npx cypress run",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-react-refresh": "^1.3.6",
    "cypress": "^13.17.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "vite": "^5.2.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "engines": {
    "node": "24"
  }
}
