{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["build", "public"],
  "plugins": ["react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "settings": {
    "react": {
      "version": "16.8"
    }
  },
  "rules": {
    "eqeqeq": "error",
    "react-hooks/exhaustive-deps": "warn"
  }
}